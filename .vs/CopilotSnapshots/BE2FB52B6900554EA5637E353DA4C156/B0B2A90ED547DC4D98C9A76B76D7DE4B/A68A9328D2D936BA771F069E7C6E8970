    <style>
        /* ── BRAND COLORS ─────────────────────── */
        :root {
            --brown: #6F4E37;
            --brown-dark: #3E2723;
            --tan: #D2B48C;
            --cream: #FDF8F2;
            --border: #e8d9cb;
        }

        body {
            font-family: "Be Vietnam Pro", sans-serif;
            background: var(--cream);
        }

        /* ── BUTTON OVERRIDES ─────────────────── */
        .btn-coffee {
            background: var(--brown) !important;
            border-color: var(--brown) !important;
            color: #fff !important;
            font-weight: 600;
        }

            .btn-coffee:hover {
                background: var(--brown-dark) !important;
                border-color: var(--brown-dark) !important;
            }

        .btn-coffee-outline {
            color: var(--brown) !important;
            border-color: var(--brown) !important;
            background: transparent !important;
            font-weight: 600;
        }

            .btn-coffee-outline:hover {
                background: var(--brown) !important;
                color: #fff !important;
            }

        .btn-dark {
            background: var(--brown) !important;
            border-color: var(--brown) !important;
            color: #fff !important;
        }

            .btn-dark:hover {
                background: var(--brown-dark) !important;
            }

        .text-warning {
            color: var(--tan) !important;
        }

        .text-danger {
            color: var(--brown) !important;
        }

        .border-warning {
            border-color: var(--tan) !important;
        }

        .logo {
            color: var(--brown) !important;
            font-family: "Playfair Display", serif;
        }

        /* ── CATEGORY TABS ────────────────────── */
        .cat-tabs {
            border-bottom: 2px solid var(--border);
            margin-bottom: 2rem;
        }

        .cat-tab {
            display: inline-block;
            padding: .55rem 1.4rem;
            font-size: .9rem;
            font-weight: 600;
            color: #888;
            text-decoration: none;
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
            transition: all .25s;
        }

            .cat-tab:hover {
                color: var(--brown);
            }

            .cat-tab.active {
                color: var(--brown);
                border-bottom-color: var(--brown);
            }

        /* ── HERO BANNER ──────────────────────── */
        .page-hero {
            background: linear-gradient(135deg, #0d3b5e 0%, #1a6a8a 100%);
            padding: 72px 0 60px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }

            .page-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E") repeat;
                pointer-events: none;
            }

            .page-hero .hero-label {
                font-size: .78rem;
                letter-spacing: 3.5px;
                font-weight: 700;
                text-transform: uppercase;
                color: #a8d8ea;
                margin-bottom: .6rem;
            }

            .page-hero h1 {
                font-family: "Playfair Display", serif;
                font-size: clamp(2.2rem, 5vw, 3.6rem);
                font-weight: 600;
                line-height: 1.15;
            }

            .page-hero .hero-desc {
                font-size: 1.05rem;
                font-weight: 300;
                opacity: .88;
                max-width: 560px;
                margin-top: .8rem;
            }

        /* Filter UI removed */

        /* ── PRODUCT CARD ─────────────────────── */
        .drink-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 3px 16px rgba(111,78,55,.07);
            transition: transform .25s, box-shadow .25s;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .drink-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 10px 32px rgba(111,78,55,.15);
            }

            .drink-card .img-wrap {
                overflow: hidden;
                position: relative;
                background: #f5ede4;
            }

                .drink-card .img-wrap img {
                    width: 100%;
                    height: 220px;
                    object-fit: cover;
                    transition: transform .45s ease;
                }

            .drink-card:hover .img-wrap img {
                transform: scale(1.07);
            }

            .drink-card .badge-label {
                position: absolute;
                top: 12px;
                left: 12px;
                background: var(--brown);
                color: #fff;
                font-size: .72rem;
                font-weight: 700;
                padding: 3px 10px;
                border-radius: 20px;
                letter-spacing: .5px;
            }

            .drink-card .card-body {
                padding: 1.1rem 1.2rem 1rem;
                display: flex;
                flex-direction: column;
                flex-grow: 1;
            }

            .drink-card .card-title {
                font-family: "Playfair Display", serif;
                font-size: 1.05rem;
                font-weight: 600;
                color: var(--brown-dark);
                margin-bottom: .35rem;
            }

            .drink-card .card-desc {
                font-size: .85rem;
                color: #888;
                flex-grow: 1;
                margin-bottom: .7rem;
                line-height: 1.55;
            }

            .drink-card .price {
                font-size: 1.1rem;
                font-weight: 700;
                color: var(--brown);
            }

            .drink-card .btn-row {
                margin-top: .7rem;
                display: flex;
                gap: .5rem;
            }

            .drink-card .btn-add {
                flex: 1;
                padding: .5rem;
                background: var(--brown);
                color: #fff;
                border: none;
                border-radius: 8px;
                font-size: .88rem;
                font-weight: 600;
                cursor: pointer;
                transition: background .2s;
            }

                .drink-card .btn-add:hover {
                    background: var(--brown-dark);
                }

            .drink-card .btn-detail {
                padding: .5rem .9rem;
                border: 1.5px solid var(--brown);
                color: var(--brown);
                background: transparent;
                border-radius: 8px;
                font-size: .88rem;
                font-weight: 600;
                cursor: pointer;
                transition: all .2s;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
            }

                .drink-card .btn-detail:hover {
                    background: var(--brown);
                    color: #fff;
                }

        /* ── TOAST ────────────────────────────── */
        #cart-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            min-width: 260px;
            display: none;
        }

            #cart-toast .inner {
                background: var(--brown-dark);
                color: #fff;
                padding: .8rem 1.2rem;
                border-radius: 12px;
                display: flex;
                align-items: center;
                gap: .6rem;
                box-shadow: 0 6px 24px rgba(0,0,0,.25);
                animation: slideUp .3s ease;
            }

        @keyframes slideUp {
            from {
                transform: translateY(20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        /* ── STORY SECTION ────────────────────── */
        .story-section {
            background: #eef7fc;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

            .story-section blockquote {
                border-left: 4px solid var(--tan);
                padding-left: 1.4rem;
                font-style: italic;
                color: var(--brown);
                font-size: 1.05rem;
            }

        /* ── CTA BANNER ───────────────────────── */
        .cta-band {
            background: var(--brown-dark);
            color: #fff;
            text-align: center;
            padding: 56px 0;
        }

            .cta-band h2 {
                font-family: "Playfair Display",serif;
                font-size: 2rem;
                margin-bottom: .5rem;
            }

            .cta-band p {
                opacity: .8;
                margin-bottom: 1.5rem;
            }
    </style>
