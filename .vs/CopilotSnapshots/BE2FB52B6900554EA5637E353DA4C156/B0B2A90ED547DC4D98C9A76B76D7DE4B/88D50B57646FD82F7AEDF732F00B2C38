            IC03: 'Matcha nguyên chất từ Nhật Bản, đắng nhẹ mà thanh, xanh mướt mà sâu.',
            IC04: 'Sốt caramel tự nấu, ngọt cháy và béo ngậy, chảy xuống giữa những tầng đá mịn.',
            IC05: 'Oreo nghiền vụn, kem vanilla mát lạnh và đá xay mịn như tuyết — không thể dừng tay.',
            CK01: 'Lớp mascarpone béo ngậy xen kẽ bánh lady finger thấm cà phê — mỗi miếng là một sự hồi sinh nhỏ.',
            CK02: 'Phô mai kem New York style — đặc, mịn và đủ đậm để bạn nhớ mãi.',
            CK03: 'Màu đỏ rực, vị cacao nhẹ, cream cheese frosting mát lạnh — Red Velvet là nghệ thuật biết nói.',
            CK04: 'Vàng giòn bên ngoài, mềm bơ bên trong — nướng tươi mỗi sáng.',
            CK05: 'Vỏ bánh choux nhẹ xốp, nhân kem vanilla béo ngậy — ăn một cái rồi lại cầm thêm cái nữa.',
        };

        const DEFAULT_PRODUCTS = [
            { id: 'CF01', name: 'Cà Phê Đen Đá', category: 'coffee', price: 29000, img: '../Images/CF01.jpg' },
            { id: 'CF02', name: 'Cà Phê Sữa Đá', category: 'coffee', price: 35000, img: '../Images/CF02.jpg' },
            { id: 'CF03', name: 'Bạc Xỉu', category: 'coffee', price: 39000, img: '../Images/CF03.jpg' },
            { id: 'CF04', name: 'Cà Phê Đen Nóng', category: 'coffee', price: 29000, img: '../Images/CF04.jpg' },
            { id: 'CF05', name: 'Cà Phê Sữa Nóng', category: 'coffee', price: 35000, img: '../Images/CF05.jpg' },
            { id: 'ES01', name: 'Espresso', category: 'espresso', price: 45000, img: '../Images/ES01.jpg' },
            { id: 'ES02', name: 'Americano', category: 'espresso', price: 49000, img: '../Images/ES02.jpg' },
            { id: 'ES03', name: 'Cappuccino', category: 'espresso', price: 55000, img: '../Images/ES03.jpg' },
            { id: 'ES04', name: 'Latte', category: 'espresso', price: 59000, img: '../Images/ES04.jpg' },
            { id: 'TE01', name: 'Trà Đào Cam Sả', category: 'tea', price: 49000, img: '../Images/TE01.jpg' },
            { id: 'TE02', name: 'Trà Vải', category: 'tea', price: 45000, img: '../Images/TE02.jpg' },
            { id: 'TE03', name: 'Trà Chanh Mật Ong', category: 'tea', price: 39000, img: '../Images/TE03.jpg' },
            { id: 'TE04', name: 'Trà Sen Vàng', category: 'tea', price: 55000, img: '../Images/TE04.jpg' },
            { id: 'TE05', name: 'Trà Dâu Tây', category: 'tea', price: 49000, img: '../Images/TE05.jpg' },
            { id: 'IC01', name: 'Chocolate Đá Xay', category: 'ice', price: 59000, img: '../Images/IC01.jpg' },
            { id: 'IC02', name: 'Cookies Đá Xay', category: 'ice', price: 65000, img: '../Images/IC02.JPG' },
            { id: 'IC03', name: 'Matcha Đá Xay', category: 'ice', price: 65000, img: '../Images/IC03.jpg' },
            { id: 'IC04', name: 'Caramel Đá Xay', category: 'ice', price: 69000, img: '../Images/IC04.jpg' },
            { id: 'IC05', name: 'Oreo Đá Xay', category: 'ice', price: 69000, img: '../Images/IC05.jpg' },
            { id: 'CK01', name: 'Tiramisu', category: 'cake', price: 45000, img: '../Images/CK01.jpg' },
            { id: 'CK02', name: 'Cheesecake', category: 'cake', price: 49000, img: '../Images/CK02.jpg' },
            { id: 'CK03', name: 'Red Velvet', category: 'cake', price: 55000, img: '../Images/CK03.jpg' },
            { id: 'CK04', name: 'Croissant Bơ', category: 'cake', price: 35000, img: '../Images/CK04.jpg' },
            { id: 'CK05', name: 'Bánh Su Kem', category: 'cake', price: 29000, img: '../Images/CK05.jpg' },
        ];

        const CATS = [
            { key: 'coffee', label: 'Cà Phê Truyền Thống', icon: 'bi-cup-hot-fill', page: 'Caphe.html' },
            { key: 'espresso', label: 'Espresso', icon: 'bi-lightning-fill', page: 'Espresso.html' },
            { key: 'tea', label: 'Trà Trái Cây', icon: 'bi-tree-fill', page: 'Tra.html' },
            { key: 'ice', label: 'Đá Xay', icon: 'bi-snow', page: 'Daxay.html' },
            { key: 'cake', label: 'Bánh Ngọt', icon: 'bi-cake2-fill', page: 'Banhngot.html' },
        ];

        function getProducts() {
            try {
                const stored = JSON.parse(localStorage.getItem('cafe_menu'));
                if (stored && stored.length) {
                    const storedIds = new Set(stored.map(p => p.id));
                    const extras = DEFAULT_PRODUCTS.filter(p => !storedIds.has(p.id));
                    return [...stored, ...extras];
                }
            } catch (e) { }
            return DEFAULT_PRODUCTS;
        }

        function fmt(n) { return Number(n).toLocaleString('vi-VN') + 'đ'; }

        // ── Render one product card ──────────────────────────────────────────────
        function cardHTML(p) {
            const desc = p.desc || FALLBACK_DESCS[p.id] || 'Thức uống thơm ngon từ Bean & Brew.';
            const cat = CATS.find(c => c.key === p.category);
            const badgeLabel = cat ? cat.label : p.category;
            return `
        <div class="col drink-card-wrap" data-cat="${p.category}" data-name="${p.name.toLowerCase()}" data-id="${p.id}">
          <div class="drink-card">
            <div class="img-wrap">
              <span class="badge-label">${badgeLabel}</span>
              <img src="${p.img}" alt="${p.name}" loading="lazy"
                   onerror="this.src='https://placehold.co/300x210/efe6e1/6f4e37?text=${encodeURIComponent(p.name)}'"/>
            </div>
            <div class="card-body">
              <div class="card-title">${p.name}</div>
              <p class="card-desc">${desc}</p>
              <div class="d-flex justify-content-between align-items-center">
                <span class="price" data-price-id="${p.id}">${fmt(p.price)}</span>
              </div>
              <div class="btn-row">
                <button class="btn-add" onclick="addToCart('${p.id}','${p.name.replace(/'/g, "\\'")}',${p.price})">
                  <i class="bi bi-cart-plus me-1"></i>Thêm vào giỏ
                </button>
                <button class="btn-detail zoom-btn" type="button" aria-label="Xem hình">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>
          </div>
        </div>`;
        }

        // ── Render all sections ──────────────────────────────────────────────────
        function renderSections() {
            const all = getProducts();
            const container = document.getElementById('all-sections');
            let html = '';

            CATS.forEach(cat => {
                const items = all.filter(p => p.category === cat.key);
                const cardRows = items.map(cardHTML).join('');
                const empty = items.length === 0
                    ? `<div class="empty-cat"><i class="bi ${cat.icon}"></i>Chưa có sản phẩm trong danh mục này.</div>`
                    : '';
                html += `
          <section id="${cat.key}" class="mb-5 cat-section" data-cat="${cat.key}">
            <div class="cat-section-title">
              <span class="dot"></span>
              <i class="bi ${cat.icon} me-2" style="color:var(--tan);font-size:1.1rem;"></i>
              ${cat.label}
              <a href="${cat.page}" class="ms-auto btn btn-sm btn-coffee-outline" style="font-size:.8rem;padding:.3rem .8rem;">
                Xem trang riêng <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
            ${empty}
            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">${cardRows}</div>
          </section>`;
            });

            container.innerHTML = html;
        }

        // ── Render sidebar ───────────────────────────────────────────────────────
        function renderSidebar() {
            const sb = document.getElementById('sidebar-list');
            sb.innerHTML = CATS.map(c => `
        <a href="#${c.key}" class="list-group-item list-group-item-action py-2" onclick="scrollToCat('${c.key}')">
          <i class="bi ${c.icon} me-2" style="color:var(--tan);"></i>${c.label}
        </a>`).join('');
        }

        function scrollToCat(key) {
            // Reset filter to show this cat
            activateFilter(key);
            setTimeout(() => {
                const el = document.getElementById(key);
                if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 100);
        }

        // ── Render cat-tabs ──────────────────────────────────────────────────────
        function renderTabs() {
            const tabs = document.getElementById('cat-tabs');
            tabs.innerHTML =
                `<button class="cat-tab active" data-tab="all" onclick="activateFilter('all')">Tất cả</button>` +
                CATS.map(c =>
                    `<button class="cat-tab" data-tab="${c.key}" onclick="activateFilter('${c.key}')">${c.label}</button>`
                ).join('');
        }

        // ── Render mega menu (navbar dropdown) ──────────────────────────────────
        function renderMegaMenu() {
            const all = getProducts();
            const mm = document.getElementById('mega-menu-inner');
            if (!mm) return;
            mm.innerHTML = CATS.map(cat => {
                const items = all.filter(p => p.category === cat.key);
                return `
          <div class="col">
            <h6 class="fw-bold text-warning border-bottom pb-1 mb-2" style="font-size:14px">${cat.label.toUpperCase()}</h6>
            <div class="d-flex flex-column">
              ${items.map(p => `<a class="dropdown-item py-05 text-truncate" href="menu.html#${cat.key}">${p.name}</a>`).join('')}
            </div>
          </div>`;
            }).join('');
        }

        // ── Filter: show/hide sections & cards ──────────────────────────────────
        let currentFilter = 'all';

        function activateFilter(key) {
            currentFilter = key;

            // Update tabs
            document.querySelectorAll('.cat-tab').forEach(t => {
                t.classList.toggle('active', t.dataset.tab === key);
            });
            // Update filter buttons
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.toggle('active', b.dataset.filter === key);
            });
            // Update sidebar
            document.querySelectorAll('#sidebar-list .list-group-item').forEach(li => {
                const href = li.getAttribute('href') || '';
                const match = href.replace('#', '');
                li.classList.toggle('active', key !== 'all' && match === key);
            });

            // Show/hide whole sections
            document.querySelectorAll('.cat-section').forEach(sec => {
                const show = key === 'all' || sec.dataset.cat === key;
                sec.style.display = show ? '' : 'none';
            });
        }

        // ── Filter buttons (bar) ─────────────────────────────────────────────────
        document.addEventListener('click', function (e) {
            const fb = e.target.closest('.filter-btn');
            if (fb) activateFilter(fb.dataset.filter);
        });

        // ── Global search ────────────────────────────────────────────────────────
        function doGlobalSearch() {
            const q = document.getElementById('global-search').value.trim().toLowerCase();
            if (!q) { activateFilter('all'); return; }

            // Show all sections first
            document.querySelectorAll('.cat-section').forEach(s => s.style.display = '');

            let totalVisible = 0;
            document.querySelectorAll('.drink-card-wrap').forEach(card => {
                const name = card.dataset.name || '';
                const desc = card.querySelector('.card-desc')?.textContent.toLowerCase() || '';
                const match = name.includes(q) || desc.includes(q);
                card.classList.toggle('hidden', !match);
                if (match) totalVisible++;
            });

            // Hide sections that have no results
            document.querySelectorAll('.cat-section').forEach(sec => {
                const visible = sec.querySelectorAll('.drink-card-wrap:not(.hidden)').length;
                sec.style.display = visible === 0 ? 'none' : '';
            });

            // Reset tab/filter UI
            document.querySelectorAll('.cat-tab,.filter-btn').forEach(el => el.classList.remove('active'));
        }

        document.getElementById('global-search').addEventListener('keydown', e => {
            if (e.key === 'Enter') doGlobalSearch();
            if (e.key === 'Escape') {
                e.target.value = '';
                document.querySelectorAll('.drink-card-wrap').forEach(c => c.classList.remove('hidden'));
                activateFilter('all');
            }
        });

        // ── Cart ─────────────────────────────────────────────────────────────────
        function addToCart(id, name, price) {
            let cart = JSON.parse(localStorage.getItem('cart') || '[]');
            const idx = cart.findIndex(i => i.id === id);
            if (idx > -1) { cart[idx].quantity++; } else { cart.push({ id, name, price, quantity: 1 }); }
            localStorage.setItem('cart', JSON.stringify(cart));
            showToast('Đã thêm "' + name + '" vào giỏ hàng!');
        }
        function showToast(msg) {
            const t = document.getElementById('cart-toast');
            document.getElementById('toast-msg').textContent = msg;
            t.style.display = 'block';
            setTimeout(() => { t.style.display = 'none'; }, 2800);
        }

        // ── Lightbox ─────────────────────────────────────────────────────────────
        (function () {
            const overlay = document.getElementById('lbOverlay');
            const lbImg = document.getElementById('lbImg');
            if (!overlay || !lbImg) return;
            let animating = false;
            function open(imgEl) {
                if (animating) return; animating = true;
                const r = imgEl.getBoundingClientRect();
                lbImg.src = imgEl.src;
                lbImg.style.cssText = `display:block;width:${r.width}px;height:${r.height}px;left:${r.left}px;top:${r.top}px;`;
                void lbImg.offsetWidth;
                overlay.classList.add('show');
                const ratio = Math.min(window.innerWidth * .88 / r.width, window.innerHeight * .88 / r.height, 2);
                const tw = r.width * ratio, th = r.height * ratio;
                lbImg.style.left = (window.innerWidth - tw) / 2 + 'px';
                lbImg.style.top = (window.innerHeight - th) / 2 + 'px';
                lbImg.style.width = tw + 'px'; lbImg.style.height = th + 'px';
                setTimeout(() => { animating = false; }, 320);
            }
            function close() {
                if (animating) return; animating = true;
                overlay.classList.remove('show');
                lbImg.style.transform = 'scale(0.95)';
                setTimeout(() => { lbImg.style.display = 'none'; lbImg.style.transform = ''; animating = false; }, 300);
            }
            document.addEventListener('click', e => {
                const z = e.target.closest('.zoom-btn');
                if (z) { const img = z.closest('.drink-card')?.querySelector('img'); if (img) open(img); return; }
                if (e.target === overlay) close();
            });
            document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
        })();

        // ── Hash-based deep link (#coffee, #espresso, …) ─────────────────────────
        function handleHash() {
            const hash = location.hash.replace('#', '');
            const valid = CATS.map(c => c.key);
            if (valid.includes(hash)) {
                activateFilter(hash);
                setTimeout(() => {
                    const el = document.getElementById(hash);
                    if (el) el.scrollIntoView({ behavior: 'smooth' });
                }, 200);
            }
        }

        // ── Init ─────────────────────────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            renderSections();
            renderSidebar();
            renderTabs();
            renderMegaMenu();
            handleHash();
        });

        // Realtime sync khi products.html cập nhật
        window.addEventListener('storage', function (e) {
            if (e.key === 'cafe_menu') {
                renderSections();
                renderMegaMenu();
            }
        });
        window.addEventListener('hashchange', handleHash);
    </script>
