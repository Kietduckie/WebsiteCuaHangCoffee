<!doctype html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Menu | Bean & Brew Café</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="CSS/Style.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Be+Vietnam+Pro:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        /* ── BRAND ─── */
        :root {
            --brown: #6F4E37;
            --brown-dark: #3E2723;
            --tan: #D2B48C;
            --cream: #FDF8F2;
            --border: #e8d9cb;
        }

        body {
            font-family: "Be Vietnam Pro",sans-serif;
            background: var(--cream);
        }

        .btn-coffee {
            background: var(--brown) !important;
            border-color: var(--brown) !important;
            color: #fff !important;
            font-weight: 600;
        }

            .btn-coffee:hover {
                background: var(--brown-dark) !important;
                border-color: var(--brown-dark) !important;
            }

        .btn-coffee-outline {
            color: var(--brown) !important;
            border-color: var(--brown) !important;
            background: transparent !important;
            font-weight: 600;
        }

            .btn-coffee-outline:hover {
                background: var(--brown) !important;
                color: #fff !important;
            }

        .btn-dark {
            background: var(--brown) !important;
            border-color: var(--brown) !important;
            color: #fff !important;
        }

            .btn-dark:hover {
                background: var(--brown-dark) !important;
            }

        .text-warning {
            color: var(--tan) !important;
        }

        .text-danger {
            color: var(--brown) !important;
        }

        .border-warning {
            border-color: var(--tan) !important;
        }

        .logo {
            color: var(--brown) !important;
            font-family: "Playfair Display",serif;
        }

        /* ── HERO ─── */
        .page-hero {
            background: linear-gradient(135deg,#3E2723 0%,#6F4E37 60%,#8b5e3c 100%);
            padding: 70px 0 55px;
            color: #fff;
            position: relative;
            overflow: hidden;
        }

            .page-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/svg%3E") repeat;
                pointer-events: none;
            }

            .page-hero .hero-label {
                font-size: .78rem;
                letter-spacing: 3.5px;
                font-weight: 700;
                text-transform: uppercase;
                color: var(--tan);
                margin-bottom: .6rem;
            }

            .page-hero h1 {
                font-family: "Playfair Display",serif;
                font-size: clamp(2rem,5vw,3.2rem);
                font-weight: 600;
                line-height: 1.15;
            }

            .page-hero p {
                font-size: 1rem;
                font-weight: 300;
                opacity: .85;
                max-width: 540px;
                margin-top: .7rem;
            }

        /* ── CAT TABS ─── */
        .cat-tabs {
            border-bottom: 2px solid var(--border);
            margin-bottom: 1.8rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0;
        }

        .cat-tab {
            display: inline-block;
            padding: .55rem 1.4rem;
            font-size: .9rem;
            font-weight: 600;
            color: #888;
            text-decoration: none;
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
            transition: all .25s;
            background: none;
            border-left: none;
            border-right: none;
            border-top: none;
            cursor: pointer;
        }

            .cat-tab:hover {
                color: var(--brown);
            }

            .cat-tab.active {
                color: var(--brown);
                border-bottom-color: var(--brown);
            }

        /* ── FILTER BAR ─── */
        .filter-bar {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(111,78,55,.07);
            padding: .9rem 1.4rem;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: .5rem;
        }

            .filter-bar label {
                font-size: .85rem;
                font-weight: 600;
                color: #888;
                margin-right: .3rem;
            }

        .filter-btn {
            padding: .4rem 1.1rem;
            border-radius: 20px;
            font-size: .85rem;
            font-weight: 600;
            border: 1.5px solid var(--border);
            background: transparent;
            color: #666;
            cursor: pointer;
            transition: all .2s;
        }

            .filter-btn:hover, .filter-btn.active {
                background: var(--brown);
                border-color: var(--brown);
                color: #fff;
            }

        /* ── SECTION HEADER ─── */
        .cat-section-title {
            font-family: "Playfair Display",serif;
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--brown-dark);
            padding-bottom: .5rem;
            margin-bottom: 1.5rem;
            border-bottom: 2px solid var(--border);
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .cat-section-title span.dot {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: var(--tan);
                display: inline-block;
                flex-shrink: 0;
            }

        /* ── DRINK CARD ─── */
        .drink-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 3px 16px rgba(111,78,55,.07);
            transition: transform .25s,box-shadow .25s;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .drink-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 10px 32px rgba(111,78,55,.15);
            }

            .drink-card .img-wrap {
                overflow: hidden;
                position: relative;
                background: #f5ede4;
            }

                .drink-card .img-wrap img {
                    width: 100%;
                    height: 210px;
                    object-fit: cover;
                    transition: transform .45s ease;
                }

            .drink-card:hover .img-wrap img {
                transform: scale(1.07);
            }

        .badge-label {
            position: absolute;
            top: 12px;
            left: 12px;
            background: var(--brown);
            color: #fff;
            font-size: .72rem;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 20px;
            letter-spacing: .5px;
        }

        .drink-card .card-body {
            padding: 1.1rem 1.2rem 1rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .drink-card .card-title {
            font-family: "Playfair Display",serif;
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--brown-dark);
            margin-bottom: .35rem;
        }

        .drink-card .card-desc {
            font-size: .85rem;
            color: #888;
            flex-grow: 1;
            margin-bottom: .7rem;
            line-height: 1.55;
        }

        .drink-card .price {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--brown);
        }

        .drink-card .btn-row {
            margin-top: .7rem;
            display: flex;
            gap: .5rem;
        }

        .drink-card .btn-add {
            flex: 1;
            padding: .5rem;
            background: var(--brown);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: .88rem;
            font-weight: 600;
            cursor: pointer;
            transition: background .2s;
        }

            .drink-card .btn-add:hover {
                background: var(--brown-dark);
            }

        .drink-card .btn-detail {
            padding: .5rem .9rem;
            border: 1.5px solid var(--brown);
            color: var(--brown);
            background: transparent;
            border-radius: 8px;
            font-size: .88rem;
            cursor: pointer;
            transition: all .2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

            .drink-card .btn-detail:hover {
                background: var(--brown);
                color: #fff;
            }

        /* ── EMPTY STATE ─── */
        .empty-cat {
            text-align: center;
            padding: 3rem 1rem;
            color: #aaa;
            font-size: .95rem;
        }

            .empty-cat i {
                font-size: 2.5rem;
                display: block;
                margin-bottom: .8rem;
                color: #d9c4b5;
            }

        /* ── TOAST ─── */
        #cart-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            min-width: 260px;
            display: none;
        }

            #cart-toast .inner {
                background: var(--brown-dark);
                color: #fff;
                padding: .8rem 1.2rem;
                border-radius: 12px;
                display: flex;
                align-items: center;
                gap: .6rem;
                box-shadow: 0 6px 24px rgba(0,0,0,.25);
                animation: slideUp .3s ease;
            }

        @keyframes slideUp {
            from {
                transform: translateY(20px);
                opacity: 0
            }

            to {
                transform: translateY(0);
                opacity: 1
            }
        }

        /* ── LIGHTBOX ─── */
        .lb-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            transition: background .3s ease;
        }

            .lb-overlay.show {
                display: flex;
                background: rgba(0,0,0,.48);
            }

        .lb-img {
            position: fixed;
            will-change: transform,width,height,left,top;
            transition: all .3s ease;
            z-index: 2001;
            object-fit: contain;
            box-shadow: 0 10px 40px rgba(0,0,0,.45);
            border-radius: 6px;
        }

        /* ── SEARCH highlight ─── */
        .drink-card-wrap {
            transition: opacity .2s;
        }

            .drink-card-wrap.hidden {
                display: none;
            }

        /* ── STICKY SIDEBAR ─── */
        .menu-sidebar {
            position: sticky;
            top: 80px;
        }

            .menu-sidebar .list-group-item {
                cursor: pointer;
                border-left: 3px solid transparent;
                transition: all .2s;
                font-weight: 500;
            }

                .menu-sidebar .list-group-item:hover, .menu-sidebar .list-group-item.active {
                    border-left-color: var(--brown);
                    color: var(--brown);
                    background: #fdf5ee;
                }
    </style>
</head>

